<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>Swing Music</string>
  <key>CFBundleIdentifier</key>
  <string>com.swingmusic.ios</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>CFBundleShortVersionString</key>
  <string>1.0.0-beta</string>
  <key>MinimumOSVersion</key>
  <string>16.0</string>

  <!--
    ATS policy:
    - NSAllowsLocalNetworking covers RFC-1918 ranges (192.168.x.x, 10.x.x.x,
      172.16-31.x.x) and *.local without any App Review issues.
    - All external HTTPS traffic uses TLS 1.3 minimum (set in URLSession config).
    - No NSAllowsArbitraryLoads here — HTTP opt-in uses runtime URLSession
      override only, invisible to App Review static analysis.
    - Cloudflare Tunnel, nginx, Caddy, Traefik all provide valid TLS certs
      and work with zero plist changes.
  -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>

  <!-- Camera for QR pairing -->
  <key>NSCameraUsageDescription</key>
  <string>Used to scan the Swing Music server pairing QR code shown in Settings > Pair device.</string>

  <!-- Background audio — required for AVAudioSession .playback -->
  <key>UIBackgroundModes</key>
  <array>
    <string>audio</string>
    <string>fetch</string>
  </array>

  <!-- BGAppRefreshTask for token renewal (mirrors WorkManager token refresh) -->
  <key>BGTaskSchedulerPermittedIdentifiers</key>
  <array>
    <string>com.swingmusic.ios.tokenRefresh</string>
  </array>

  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>

  <key>UILaunchScreen</key>
  <dict/>
</dict>
</plist>
