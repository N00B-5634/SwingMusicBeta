<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>Swing Music</string>
  <key>CFBundleDisplayName</key>
  <string>Swing Music</string>
  <key>CFBundleIdentifier</key>
  <string>com.swingmusic.ios</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>CFBundleShortVersionString</key>
  <string>1.0.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>

  <key>CFBundleIconName</key>
  <string>AppIcon</string>
  <key>CFBundleIcons</key>
  <dict>
    <key>CFBundlePrimaryIcon</key>
    <dict>
      <key>CFBundleIconName</key>
      <string>AppIcon</string>
      <key>CFBundleIconFiles</key>
      <array><string>AppIcon</string></array>
    </dict>
  </dict>

  <!--
    ATS policy:
    NSAllowsArbitraryLoads = true is required for the app to connect to
    user-configured servers over HTTP. Swing Music runs on a self-hosted
    server at any URL the user provides — we cannot whitelist specific domains.
    The user explicitly acknowledges HTTP risk via the ATSWarningSheet before
    any HTTP connection is made. HTTPS is always used when the URL starts with
    https://.

    NSAllowsLocalNetworking covers 192.168.x.x, 10.x.x.x, 172.16-31.x.x,
    and *.local without requiring a TLS cert — essential for LAN servers.
  -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <true/>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>

  <key>NSCameraUsageDescription</key>
  <string>Used to scan the Swing Music server pairing QR code.</string>

  <key>UIBackgroundModes</key>
  <array>
    <string>audio</string>
    <string>fetch</string>
  </array>

  <key>BGTaskSchedulerPermittedIdentifiers</key>
  <array>
    <string>com.swingmusic.ios.tokenRefresh</string>
  </array>

  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>

  <key>UILaunchScreen</key>
  <dict/>

  <key>MinimumOSVersion</key>
  <string>16.0</string>
  <key>LSRequiresIPhoneOS</key>
  <true/>
</dict>
</plist>
